<div class="min-h-screen px-4 py-8 md:py-12">
  <div class="mx-auto w-full max-w-4xl">
    <div class="mb-6 md:mb-8 text-center">
      <h1 class="text-3xl md:text-4xl font-extrabold tracking-tight text-white">Edit <span class="text-cyan-400"><%= @amazon_pdf.name %></span></h1>
      <p class="mt-2 text-sm md:text-base text-slate-200/90">Update the document source, details, or program assignment.</p>
    </div>

    <%= simple_form_for @amazon_pdf, html: { class: "rounded-2xl border border-white/25 bg-slate-900/55 shadow-2xl backdrop-blur-sm p-5 md:p-8 text-white space-y-6", autocomplete: 'off' } do |f| %>
      <%= render 'form', form: f %>

      <div class="flex flex-wrap justify-center gap-3 text-white">
        <%= link_to 'Back', amazon_pdfs_path, class: "bg-gray-500 hover:bg-gray-700 text-white font-bold py-2 px-4 rounded" %>
        <%= f.button :submit, "Update Document", class: "bg-blue-500 hover:bg-blue-700 text-white font-bold py-2 px-4 rounded" %>
      </div>
    <% end %>
  </div>
</div>
