<div class="min-h-screen px-4 py-8 md:py-12">
  <div class="mx-auto w-full max-w-4xl">
    <div class="mb-6 md:mb-8">
      <h3 class="text-3xl md:text-4xl font-extrabold tracking-tight text-white">Upload Document</h3>
      <p class="mt-2 text-sm md:text-base text-slate-200/90">Add a PDF upload or a Google Docs / Drive link so families can find it quickly.</p>
    </div>

    <%= simple_form_for @amazon_pdf, url: amazon_pdfs_path, method: :post, html: { class: "rounded-2xl border border-white/25 bg-slate-900/55 shadow-2xl backdrop-blur-sm p-5 md:p-8 text-white space-y-6", autocomplete: 'off' } do |form| %>
      <%= render 'form', form: form %>

      <div class="pt-2">
        <%= form.submit "Create Document", class: "inline-flex items-center justify-center rounded-lg bg-sky-600 px-6 py-2.5 text-sm font-bold text-white shadow-lg shadow-sky-700/30 transition hover:bg-sky-500 focus:outline-none focus:ring-2 focus:ring-sky-400/70" %>
      </div>
    <% end %>
  </div>
</div>
