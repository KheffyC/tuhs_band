<div class="min-h-[88vh] bg-neutral-950 px-4 py-8 md:px-8 md:py-12">
  <section class="mx-auto w-full max-w-5xl space-y-8">
    <div class="space-y-3 text-center">
      <h1 class="text-3xl md:text-5xl font-extrabold tracking-tight text-white">Contact</h1>
      <p class="mx-auto max-w-3xl text-sm md:text-base text-slate-200/90">
        Phone numbers are also listed for direct calls in need of emergency only. 
      </p>
    </div>

    <div>
      <div class="mx-auto grid max-w-4xl grid-cols-1 items-stretch gap-5 md:grid-cols-2">
        <% director_email = @school&.director_email.presence || 'mario.capote@tulare.k12.ca.us' %>
        <article
          class="flex h-full flex-col justify-between rounded-2xl border border-sky-300/30 bg-gradient-to-br from-sky-500/15 via-slate-900/80 to-slate-950/90 p-6 text-white shadow-xl shadow-sky-500/20 ring-1 ring-sky-200/20 backdrop-blur-sm"
          x-data="{ feedback: '', timer: null, async copyEmail(email) { const copied = await window.copyTextToClipboard(email); this.feedback = copied ? 'Email copied' : 'Copy failed'; clearTimeout(this.timer); this.timer = setTimeout(() => { this.feedback = '' }, 1800) } }"
        >
          <div class="space-y-1.5">
            <h3 class="mb-2 text-lg font-bold">Director of Instrumental Music</h3>
            <p class="text-slate-100"><%= @school&.director_name.presence || 'Mario Capote' %></p>
            <p class="text-slate-200"><%= @school&.director_phone.presence || '(559) 686-4761' %></p>
            <div class="mt-2 space-y-2">
              <%= mail_to director_email, director_email, class: 'inline-flex break-all text-slate-200 underline decoration-white/30 underline-offset-4 transition hover:text-white' %>
              <div class="flex flex-wrap gap-2">
                <%= link_to 'Open in Gmail', "https://mail.google.com/mail/?view=cm&fs=1&to=#{ERB::Util.url_encode(director_email)}", target: '_blank', rel: 'noopener', class: 'inline-flex items-center rounded-full border border-white/15 bg-white/5 px-3 py-1.5 text-xs font-semibold text-white transition hover:bg-white/10' %>
                <button type="button" @click="copyEmail('<%= j director_email %>')" class="inline-flex items-center rounded-full border border-white/15 bg-white/5 px-3 py-1.5 text-xs font-semibold text-white transition hover:bg-white/10">Copy Email</button>
              </div>
              <p x-show="feedback" x-text="feedback" x-cloak class="text-xs font-semibold text-emerald-200"></p>
            </div>
          </div>
        </article>

        <% booster_email = 'tuhsbandboosters@gmail.com' %>
        <article
          class="flex h-full flex-col justify-between rounded-2xl border border-violet-300/30 bg-gradient-to-br from-violet-500/15 via-slate-900/80 to-slate-950/90 p-6 text-white shadow-xl shadow-violet-500/20 ring-1 ring-violet-200/20 backdrop-blur-sm"
          x-data="{ feedback: '', timer: null, async copyEmail(email) { const copied = await window.copyTextToClipboard(email); this.feedback = copied ? 'Email copied' : 'Copy failed'; clearTimeout(this.timer); this.timer = setTimeout(() => { this.feedback = '' }, 1800) } }"
        >
          <div class="space-y-1.5">
            <h3 class="mb-2 text-lg font-bold">Booster Questions</h3>
            <div class="mt-2 space-y-2">
              <%= mail_to booster_email, booster_email, class: 'inline-flex break-all text-slate-100 underline decoration-white/30 underline-offset-4 transition hover:text-white' %>
              <div class="flex flex-wrap gap-2">
                <%= link_to 'Open in Gmail', "https://mail.google.com/mail/?view=cm&fs=1&to=#{ERB::Util.url_encode(booster_email)}", target: '_blank', rel: 'noopener', class: 'inline-flex items-center rounded-full border border-white/15 bg-white/5 px-3 py-1.5 text-xs font-semibold text-white transition hover:bg-white/10' %>
                <button type="button" @click="copyEmail('<%= j booster_email %>')" class="inline-flex items-center rounded-full border border-white/15 bg-white/5 px-3 py-1.5 text-xs font-semibold text-white transition hover:bg-white/10">Copy Email</button>
              </div>
              <p x-show="feedback" x-text="feedback" x-cloak class="text-xs font-semibold text-emerald-200"></p>
            </div>
          </div>
        </article>

        <% percussion_email = @school&.percussion_director_email.presence || 'testuser@gmail.com' %>
        <article
          class="flex h-full flex-col justify-between rounded-2xl border border-emerald-300/30 bg-gradient-to-br from-emerald-500/15 via-slate-900/80 to-slate-950/90 p-6 text-white shadow-xl shadow-emerald-500/20 ring-1 ring-emerald-200/20 backdrop-blur-sm"
          x-data="{ feedback: '', timer: null, async copyEmail(email) { const copied = await window.copyTextToClipboard(email); this.feedback = copied ? 'Email copied' : 'Copy failed'; clearTimeout(this.timer); this.timer = setTimeout(() => { this.feedback = '' }, 1800) } }"
        >
          <div class="space-y-1.5">
            <h3 class="mb-2 text-lg font-bold">Percussion Caption Head</h3>
            <p class="text-slate-100"><%= @school&.percussion_director_name.presence || 'Test User' %></p>
            <p class="text-slate-200"><%= @school&.percussion_director_phone.presence || '(559) 799-XXXX' %></p>
            <div class="mt-2 space-y-2">
              <%= mail_to percussion_email, percussion_email, class: 'inline-flex break-all text-slate-200 underline decoration-white/30 underline-offset-4 transition hover:text-white' %>
              <div class="flex flex-wrap gap-2">
                <%= link_to 'Open in Gmail', "https://mail.google.com/mail/?view=cm&fs=1&to=#{ERB::Util.url_encode(percussion_email)}", target: '_blank', rel: 'noopener', class: 'inline-flex items-center rounded-full border border-white/15 bg-white/5 px-3 py-1.5 text-xs font-semibold text-white transition hover:bg-white/10' %>
                <button type="button" @click="copyEmail('<%= j percussion_email %>')" class="inline-flex items-center rounded-full border border-white/15 bg-white/5 px-3 py-1.5 text-xs font-semibold text-white transition hover:bg-white/10">Copy Email</button>
              </div>
              <p x-show="feedback" x-text="feedback" x-cloak class="text-xs font-semibold text-emerald-200"></p>
            </div>
          </div>
        </article>
      </div>
    </div>
  </section>
</div>