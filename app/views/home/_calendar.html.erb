<section
    id="main-calendar"
    class="relative my-8 w-[90%] mx-auto overflow-hidden rounded-3xl bg-gray-100 sm:my-10"
>
    <div class="pointer-events-none absolute -left-16 -top-20 h-52 w-52 rounded-full bg-red-300/40 blur-3xl"></div>
    <div class="pointer-events-none absolute -bottom-24 -right-20 h-64 w-64 rounded-full bg-sky-300/30 blur-3xl"></div>
    <div class="pointer-events-none absolute inset-0 bg-[linear-gradient(125deg,rgba(255,255,255,0.5)_0%,rgba(255,255,255,0)_42%,rgba(255,255,255,0.45)_100%)]"></div>

    <div class="relative z-10 px-4 pb-5 pt-3 sm:px-6 sm:pb-6 sm:pt-4 lg:px-8 lg:pb-8 lg:pt-5">
        <div class="mb-4 flex flex-col gap-2 text-left sm:mb-6">
            <span class="inline-flex w-fit items-center rounded-full bg-white/80 px-3 py-1 text-xs font-semibold uppercase tracking-[0.2em] text-gray-700">
                Live Schedule
            </span>
            <h2 class="text-2xl font-bold text-gray-900 sm:text-3xl lg:text-4xl">Upcoming Events and Rehearsals</h2>
            <p class="max-w-3xl text-sm text-gray-700 sm:text-base">
                Keep up with concerts, rehearsals, travel, and important deadlines. This calendar updates in real time so students and families can plan ahead.
            </p>
        </div>

        <div class="flex flex-col gap-4 sm:gap-5 lg:flex-row lg:items-start lg:gap-5 xl:gap-6">
            <div class="h-[48vh] overflow-x-auto overflow-y-hidden rounded-2xl bg-white shadow-[0_14px_35px_rgba(17,24,39,0.18)] sm:h-[75vh] lg:h-[80vh] lg:flex-[1.35]">
                <iframe
                    class="h-full w-[860px] min-w-[860px] sm:min-w-0 sm:w-full"
                    src="<%= "https://calendar.google.com/calendar/embed?src=kheffy.cervantez%40gmail.com&ctz=America%2FLos_Angeles" || @school.calendar_url %>"
                    style="border:0;"
                    frameborder="0"
                    scrolling="no"
                    loading="lazy"
                    referrerpolicy="no-referrer-when-downgrade"
                ></iframe>
            </div>

            <aside class="rounded-2xl bg-white/65 p-4 text-gray-700 shadow-[0_10px_25px_rgba(17,24,39,0.08)] sm:p-5 lg:w-[220px] lg:flex-none xl:w-[240px]">
                <h3 class="text-base font-semibold text-gray-900">Quick Access</h3>
                <p class="mt-1.5 text-xs text-gray-600">Need forms or help?</p>

                <div class="mt-3.5 space-y-2 sm:mt-4 sm:space-y-2.5">
                    <%= link_to 'View Documents', amazon_pdfs_path, class: 'block rounded-lg bg-gray-900 px-3.5 py-2 text-xs font-medium text-white transition hover:bg-black sm:py-2.5' %>
                    <%= link_to 'Contact Directors', contacts_path, class: 'block rounded-lg bg-gray-900 px-3.5 py-2 text-xs font-medium text-white transition hover:bg-black sm:py-2.5' %>
                    <%= link_to 'Support Fundraising', fundraisers_path, class: 'block rounded-lg bg-gray-900 px-3.5 py-2 text-xs font-medium text-white transition hover:bg-black sm:py-2.5' %>
                </div>

                <div class="mt-3.5 rounded-xl bg-gray-100/90 p-3 sm:mt-4 sm:p-3.5">
                    <p class="text-xs uppercase tracking-[0.2em] text-gray-500">Tip</p>
                    <p class="mt-1.5 text-xs text-gray-700">Add this calendar to your phone for automatic updates on rehearsal changes and performance times.</p>
                </div>
            </aside>
        </div>
    </div>
</section>