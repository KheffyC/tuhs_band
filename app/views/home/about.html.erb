<%= render 'hero', school: @school, page_title: 'Class Schedule' %>

<section class="w-full bg-neutral-950 px-4 py-16 sm:px-6 sm:py-20 lg:px-8 lg:py-24">
  <div class="mx-auto w-[94%] sm:w-[90%] lg:w-[80%]">

    <div class="mb-10 text-center sm:mb-14">
      <h2 class="section-title text-white">Band Periods</h2>
      <% if @school.about.present? %>
        <p class="section-subtitle mx-auto mt-4 max-w-3xl text-white/70"><%= @school.about %></p>
      <% end %>
    </div>

    <div class="space-y-6 lg:space-y-8">
      <% @school.programs.order(:period).each_with_index do |program, i| %>
        <%= link_to program_path(program), class: 'group block' do %>
        <article class="flex flex-col overflow-hidden bg-neutral-900 shadow-[0_14px_30px_rgba(0,0,0,0.4)] transition duration-300 hover:shadow-[0_22px_45px_rgba(185,28,28,0.3)] sm:flex-row">

          <%# Image — alternate side on desktop for visual rhythm %>
          <div class="relative h-56 w-full shrink-0 overflow-hidden sm:h-auto sm:w-64 lg:w-80 <%= i.odd? ? 'sm:order-last' : '' %>">
            <%= image_tag(
              program.main_gallery_image_url&.strip.presence || @school.default_image,
              alt: program.description,
              class: 'h-full w-full object-cover transition duration-500 group-hover:scale-105'
            ) %>
            <div class="pointer-events-none absolute inset-0 bg-gradient-to-t from-black/60 to-transparent sm:bg-gradient-to-r sm:from-transparent sm:to-black/30"></div>
          </div>

            <div class="flex flex-1 flex-col justify-between gap-4 p-6 sm:p-8 lg:p-10">
            <div>
              <div class="mb-3 flex flex-wrap items-center gap-2">
                <span class="inline-flex items-center rounded-full bg-red-700/80 px-3 py-1 text-[10px] font-semibold uppercase tracking-[0.2em] text-white">
                  Period <%= program.period %>
                </span>
                <span class="inline-flex items-center rounded-full bg-white/10 px-3 py-1 text-[10px] font-semibold uppercase tracking-[0.2em] text-white/70">
                  <%= program.description %>
                </span>
              </div>

              <h3 class="text-2xl font-bold text-white sm:text-3xl"><%= program.hero_title %></h3>

              <% if program.detailed_description.present? %>
                <p class="mt-3 text-sm leading-relaxed text-white/70 sm:text-base"><%= program.detailed_description %></p>
              <% end %>
            </div>

            </div>
          </article>
        <% end %>
      <% end %>
    </div>

  </div>
</section>