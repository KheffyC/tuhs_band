<section class="w-full bg-neutral-950 px-4 py-16 sm:px-6 sm:py-20 lg:px-8 lg:py-24">
  <div class="mx-auto max-w-7xl w-[94%] sm:w-[90%] lg:w-[80%]">

    <div class="mb-10 text-center sm:mb-14">
      <h2 class="section-title text-white">Band Periods</h2>
      <% if @school.about.present? %>
        <p class="section-subtitle mx-auto mt-4 max-w-3xl text-white/70"><%= @school.about %></p>
      <% end %>
    </div>

    <div class="space-y-0">
      <% @school.programs.order(:period).each_with_index do |program, i| %>
        <% unless i == 0 %>
          <hr class="border-0 border-t-2 border-amber-300 my-6 lg:my-8" />
        <% end %>

        <div class="flex flex-col gap-6 sm:flex-row sm:gap-8 lg:gap-10 py-6 lg:py-8">
          <%# Image — consistent side %>
          <div class="relative h-56 w-full shrink-0 overflow-hidden sm:h-64 sm:w-64 lg:h-72 lg:w-72">
            <%= image_tag(
                safe_image_source(program.main_gallery_image_url&.strip.presence || @school.default_image),
              alt: program.description,
              class: 'h-full w-full object-cover'
            ) %>
          </div>

          <div class="flex flex-1 flex-col justify-center gap-3">
            <div class="flex flex-wrap items-center gap-2">
              <span class="inline-flex items-center rounded-full bg-red-700/80 px-3 py-1 text-[10px] font-semibold uppercase tracking-[0.2em] text-white">
                Period <%= program.period %>
              </span>
              <span class="inline-flex items-center rounded-full bg-white/10 px-3 py-1 text-[10px] font-semibold uppercase tracking-[0.2em] text-white/70">
                <%= program.description %>
              </span>
            </div>

            <h3 class="text-2xl font-bold text-white sm:text-3xl"><%= program.hero_title %></h3>

            <% if program.detailed_description.present? %>
              <p class="text-sm leading-relaxed text-white/70 sm:text-base"><%= program.detailed_description %></p>
            <% end %>
          </div>
        </div>
      <% end %>
    </div>

  </div>
</section>