<footer class="text-white" style="background: #621414; border-top: 1px solid rgba(251, 191, 36, 0.5);">
  <div class="mx-auto w-full max-w-7xl px-6 py-6 sm:px-10 lg:px-14">
    <div class="flex flex-col gap-6 sm:flex-row sm:items-center sm:justify-between">

      <div class="flex flex-col gap-1">
        <h6 class="text-sm font-semibold uppercase tracking-[0.2em] text-white"><%= @school.name || '' %> Music Department</h6>
        <span class="text-xs text-white/50">© <%= Time.current.year %> All rights reserved.</span>
        <span class="text-xs text-white/40">Site by <%= link_to 'KnownReference', 'https://knownreference.com', target: '_blank', rel: 'noopener', class: 'underline underline-offset-2 transition hover:text-white/70' %></span>
        <% if current_director.present? %>
          <%= link_to "Sign out", destroy_director_session_path, data: { turbo_method: :delete }, class: 'mt-1 w-fit inline-flex rounded-md border border-white/20 px-3 py-1.5 text-xs font-semibold text-white/80 transition hover:bg-white/10' %>
        <% end %>
      </div>

      <nav class="flex flex-wrap gap-x-6 gap-y-2 text-sm text-white/80">
        <%= link_to 'Calendar', '/#main-calendar', class: 'transition hover:text-white' %>
        <%= link_to 'Documents', amazon_pdfs_path, class: 'transition hover:text-white' %>
        <%= link_to 'Class Periods', home_about_path, class: 'transition hover:text-white' %>
        <%= link_to 'Contact', contacts_path, class: 'transition hover:text-white' %>
      </nav>

      <div class="flex flex-wrap items-center gap-2">
        <% if donations_enabled? %>
          <%= link_to 'Donate', donations_path, class: 'inline-flex items-center justify-center rounded-md bg-red-700 px-4 py-2 text-sm font-semibold text-white transition hover:bg-red-600' %>
        <% end %>
        <%= link_to 'Fundraisers', fundraisers_path, class: 'inline-flex items-center justify-center rounded-md border border-white/20 px-4 py-2 text-sm font-semibold text-white/80 transition hover:bg-white/10' %>
        <% if current_director.present? %>
          <%= link_to 'Admin', admin_root_path, class: 'inline-flex items-center justify-center rounded-md border border-white/20 px-4 py-2 text-sm font-semibold text-white/80 transition hover:bg-white/10' %>
        <% else %>
          <%= link_to 'Director Login', new_director_session_path, class: 'inline-flex items-center justify-center rounded-md border border-white/20 px-4 py-2 text-sm font-semibold text-white/80 transition hover:bg-white/10' %>
        <% end %>
      </div>

    </div>
  </div>
</footer>