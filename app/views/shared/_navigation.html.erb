<header x-data="navbar">
	<nav class="top-0 flex min-h-[68px] w-full items-center justify-between px-4 py-3 lg:relative lg:z-0 lg:min-h-[104px]" style="background: #621414; border-bottom: 1px solid rgba(251, 191, 36, 0.5)">
		<%= link_to image_tag('logo.png', class: 'h-10 w-auto sm:h-14'), root_path, class: "flex items-center pl-2" %>
		<div class="2x-lg:hidden x-lg:hidden lg:hidden">
			<button @click="toggle()" @touchend="toggle()" class="navbar-burger flex items-center text-blue-600 p-3">
				<svg class="block h-6 w-4 fill-current" viewBox="0 0 20 20" xmlns="http://www.w3.org/2000/svg">
					<title>Mobile menu</title>
					<path d="M0 3h20v2H0V3zm0 6h20v2H0V9zm0 6h20v2H0v-2z"></path>
				</svg>
			</button>
		</div>
		<ul class="hidden absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 transform x-lg:mx-auto x-lg:flex x-lg:items-center x-lg:w-auto lg:flex lg:w-auto lg:items-center lg:divide-x lg:divide-white/30">
			<% if @school&.staff_enabled? %>
				<li class="px-4"><%= link_to 'Our Staff', staff_members_path, class: "text-base text-white hover:text-gray-500 lg:text-xl" %></li>
			<% end %>
			<li class="px-4"><%= link_to 'Class Schedule', home_about_path, class: "text-base text-white hover:text-gray-500 lg:text-xl" %></li>
			<li class="px-4"><%= link_to 'Documents', amazon_pdfs_path, class: "text-base text-white hover:text-gray-500 lg:text-xl" %></li>
			<% if @school&.photo_gallery_enabled? %>
				<li class="px-4"><%= link_to 'Photos', galleries_path, class: "text-base text-white hover:text-gray-500 lg:text-xl" %></li>
			<% end %>
			<% if @school&.fundraisers_enabled? %>
				<li class="px-4"><%= link_to 'Fundraisers', fundraisers_path, class: "text-base text-white hover:text-gray-500 lg:text-xl" %></li>
			<% end %>		<% if @school&.boosters_enabled? %>
			<li class="px-4"><%= link_to 'Boosters', boosters_path, class: "text-base text-white hover:text-gray-500 lg:text-xl" %></li>
		<% end %>			<li class="px-4"><%= link_to 'Contact', contacts_path, class: "text-base text-white hover:text-gray-500 lg:text-xl" %></li>
		</ul>
		<%= link_to 'CUT TIME LOGIN', "https://app.gocuttime.com/login", target: '_blank', class: "hidden lg:inline-block lg:ml-auto py-2 px-6 outline text-sm outline-white hover:bg-white hover:text-black text-gray-300 font-bold  transition duration-200" %>
		<% if donations_enabled? %>
			<%= link_to 'DONATE', donations_path, class: "hidden lg:inline-block py-2 px-6 mx-4 hover:bg-blue-600 outline text-sm outline-white text-white font-bold transition duration-200" %>
		<% end %>
	</nav>
	<div id="navbar-menu" class="navbar-menu relative z-50 hidden">
		<div @click="toggle()" @touchend="toggle()" class="navbar-backdrop fixed inset-0 bg-gray-800 opacity-25"></div>
		<nav class="fixed top-0 left-0 bottom-0 flex flex-col w-5/6 max-w-sm py-6 px-6 bg-white border-r overflow-y-auto" style="background: #621414;">
			<div class="flex justify-between items-center mb-4" >
			<%= link_to image_tag('logo.png', class: 'h-12 w-auto'), root_path, class: 'flex items-center pl-2'%>
				<button @click="toggle()" @touchend="toggle()" class="navbar-close">X</button>
			</div>
			<hr class="text-black" />
			<div>
				<ul>
					<li class="mb-1"><%= link_to 'Home', home_index_path, class: "block p-4 text-sm font-semibold text-gray-100 hover:bg-red-500 hover:text-black rounded" %></li>
					<% if @school&.staff_enabled? %>
						<li class="mb-1"><%= link_to 'Our Staff', staff_members_path, class: "block p-4 text-sm font-semibold text-gray-100 hover:bg-red-500 hover:text-black rounded" %></li>
					<% end %>
					<li class="mb-1"><%= link_to 'Class Schedule', home_about_path, class: "block p-4 text-sm font-semibold text-gray-100 hover:bg-red-500 hover:text-black rounded" %></li>
					<li class="mb-1"><%= link_to 'Documents', amazon_pdfs_path, class: "block p-4 text-sm font-semibold text-gray-100 hover:bg-red-500 hover:text-black rounded" %></li>
					<% if @school&.photo_gallery_enabled? %>
						<li class="mb-1"><%= link_to 'Photos', galleries_path, class: "block p-4 text-sm font-semibold text-gray-100 hover:bg-red-500 hover:text-black rounded" %></li>
					<% end %>
					<% if @school&.fundraisers_enabled? %>
						<li class="mb-1"><%= link_to 'Fundraisers', fundraisers_path, class: "block p-4 text-sm font-semibold text-gray-100 hover:bg-red-500 hover:text-black rounded" %></li>
					<% end %>				<% if @school&.boosters_enabled? %>
					<li class="mb-1"><%= link_to 'Boosters', boosters_path, class: "block p-4 text-sm font-semibold text-gray-100 hover:bg-red-500 hover:text-black rounded" %></li>
				<% end %>					<li class="mb-1"><%= link_to 'Contact',  contacts_path, class: "block p-4 text-sm font-semibold text-gray-100 hover:bg-red-500 hover:text-black rounded" %></li>
				</ul>
				<div class="pt-6">
					<%= link_to 'CUT TIME LOGIN', "https://app.gocuttime.com/login", target: '_blank', class: "block px-4 py-3 mb-3 leading-loose text-sm text-center font-semibold bg-gray-50 hover:bg-blue-600 outline outline-white rounded-xl"%>
					<% if donations_enabled? %>
						<%= link_to 'DONATE', donations_path, class: "block px-4 py-3 mb-3 leading-loose text-sm text-center font-semibold bg-gray-50 hover:bg-blue-600 outline outline-white rounded-xl"%>
					<% end %>
				</div>
			</div>
			<div class="mt-auto">
				<p class="my-4 text-xs text-center text-white">
					<span>Copyright © <%= Time.current.year %></span>
				</p>
			</div>
		</nav>
	</div>
</header>
<script>
	document.addEventListener('alpine:init', () => {
		Alpine.data('navbar', () => ({
			open: false,
			toggle(){
				this.open = !this.open
				let navMenu = document.getElementById('navbar-menu')
				this.open ? navMenu.classList.remove('hidden') : navMenu.classList.add('hidden')
			},
		}))
	})
</script>